<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Dkafe.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Dkafe.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Dkafe.Field" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/dkafe_field</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/dkafe_text</item>
        <item name="android:textColorHint">@color/dkafe_secondary</item>
    </style>
    <style name="Dkafe.Title" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/dkafe_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="Dkafe.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/dkafe_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Dkafe.Label" parent="Dkafe.Body">
        <item name="android:textColor">@color/dkafe_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>