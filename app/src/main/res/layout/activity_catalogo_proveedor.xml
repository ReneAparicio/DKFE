<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dkafe_cream">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/catalogo_proveedor"
        style="@style/Dkafe.Title" />
    <androidx.appcompat.widget.SearchView
        android:id="@+id/buscador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" xmlns:app="http://schemas.android.com/apk/res-auto"
        app:iconifiedByDefault="false"
        app:queryHint="@string/buscar_nombre_proveedor"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/dkafe_row" />
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/filtroAlimentos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:minHeight="48dp"
        android:text="@string/filtro_todos"
        style="@style/Dkafe.Body" />
    <ProgressBar
        android:id="@+id/progresoCatalogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/dkafe_wine"
        android:visibility="gone" />
    <TextView
        android:id="@+id/textoEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:accessibilityLiveRegion="polite"
        style="@style/Dkafe.Body" />
    <Button
        android:id="@+id/botonReintentar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/reintentar_catalogo"
        android:visibility="gone"
        style="@style/Dkafe.Button" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaProductos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp" />
</LinearLayout>
