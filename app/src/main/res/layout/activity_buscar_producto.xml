<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".view.BuscarProductoActivity"
    android:background="@color/dkafe_cream">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/buscar_producto_por_id"
            style="@style/Dkafe.Title" />
        <TextView
            style="@style/Dkafe.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/id_producto"
            android:labelFor="@id/campoId"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />
        <EditText
            android:id="@+id/campoId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/id_producto"
            android:inputType="text"
            android:maxLines="1"
            style="@style/Dkafe.Field" />
        <Button
            android:id="@+id/botonBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/buscar"
            android:textAllCaps="false"
            style="@style/Dkafe.Button" />
        <TextView
            android:id="@+id/textoEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            style="@style/Dkafe.Body" />
        <LinearLayout
            android:id="@+id/resultadoProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/textoNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                style="@style/Dkafe.Body"
                android:textColor="@color/dkafe_text"
                android:layout_marginBottom="4dp" />
            <TextView
                android:id="@+id/textoDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                style="@style/Dkafe.Body" />
            <TextView
                android:id="@+id/textoPrecio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Dkafe.Body"
                android:textColor="@color/dkafe_wine"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/textoStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Dkafe.Body"
                android:layout_marginTop="6dp" />
            <TextView
                android:id="@+id/textoCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Dkafe.Body"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>