<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dkafe_cream"
    tools:context=".view.InicioActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <FrameLayout
            android:id="@+id/encabezadoInicio"
            android:layout_width="match_parent"
            android:layout_height="280dp">
            <ImageView
                android:id="@+id/fotoInicio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/fondo_cafeteria"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />
            <FrameLayout
                android:id="@+id/tarjetaLogo"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/inicio_logo_fondo"
                android:padding="16dp">
                <ImageView
                    android:id="@+id/logoInicio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:src="@drawable/logo_dkafe"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/app_name" />
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">
        <LinearLayout
            android:id="@+id/botonCatalogoProveedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/inicio_tarjeta_fondo"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/inicio_icono_fondo"
                android:padding="12dp"
                android:src="@drawable/inicio_catalogo"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:text="@string/catalogo_proveedor"
                android:textSize="16sp"
                android:textColor="@color/dkafe_text"
                android:fontFamily="sans-serif-medium" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/inicio_flecha"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/botonInventario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/inicio_tarjeta_fondo"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/inicio_icono_fondo"
                android:padding="12dp"
                android:src="@drawable/inicio_inventario"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:text="@string/inventario"
                android:textSize="16sp"
                android:textColor="@color/dkafe_text"
                android:fontFamily="sans-serif-medium" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/inicio_flecha"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/botonCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/inicio_tarjeta_fondo"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/inicio_icono_fondo"
                android:padding="12dp"
                android:src="@drawable/inicio_categorias"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:text="@string/categorias"
                android:textSize="16sp"
                android:textColor="@color/dkafe_text"
                android:fontFamily="sans-serif-medium" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/inicio_flecha"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/botonReporteInventario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/inicio_tarjeta_fondo"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/inicio_icono_fondo"
                android:padding="12dp"
                android:src="@drawable/inicio_reporte"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:text="@string/reporte_inventario"
                android:textSize="16sp"
                android:textColor="@color/dkafe_text"
                android:fontFamily="sans-serif-medium" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/inicio_flecha"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/botonBuscarProductoPorId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/inicio_tarjeta_fondo"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/inicio_icono_fondo"
                android:padding="12dp"
                android:src="@drawable/inicio_buscar"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="16dp"
                android:text="@string/buscar_producto_por_id"
                android:textSize="16sp"
                android:textColor="@color/dkafe_text"
                android:fontFamily="sans-serif-medium" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/inicio_flecha"
                android:importantForAccessibility="no" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
