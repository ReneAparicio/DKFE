<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".view.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/botonCatalogoProveedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/catalogo_proveedor"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/botonInventario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/inventario"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/botonCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/categorias"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/botonReporteInventario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reporte_inventario"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/botonBuscarProductoPorId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/buscar_producto_por_id"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
