<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".view.CrearProductoActivity"
    android:background="@color/dkafe_cream">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/crear_producto"
            style="@style/Dkafe.Title" />
        <TextView
            style="@style/Dkafe.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nombre"
            android:labelFor="@id/campoNombre"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />
        <EditText
            android:id="@+id/campoNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/nombre"
            android:inputType="textCapSentences"
            android:maxLines="1"
            style="@style/Dkafe.Field" />
        <TextView
            style="@style/Dkafe.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/descripcion"
            android:labelFor="@id/campoDescripcion"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />
        <EditText
            android:id="@+id/campoDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/descripcion"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top"
            android:minLines="2"
            style="@style/Dkafe.Field" />
        <TextView
            style="@style/Dkafe.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/precio"
            android:labelFor="@id/campoPrecio"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />
        <EditText
            android:id="@+id/campoPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/precio"
            android:inputType="numberDecimal"
            android:maxLines="1"
            style="@style/Dkafe.Field" />
        <TextView
            style="@style/Dkafe.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stock"
            android:labelFor="@id/campoStock"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />
        <EditText
            android:id="@+id/campoStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="@string/stock"
            android:inputType="number"
            android:maxLines="1"
            style="@style/Dkafe.Field" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/categoria"
            style="@style/Dkafe.Body" />
        <Spinner
            android:id="@+id/selectorCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:prompt="@string/seleccionar_categoria"
            android:enabled="false"
            android:background="@drawable/dkafe_row"
            android:padding="8dp"
            android:layout_marginTop="6dp" />
        <TextView
            android:id="@+id/textoEstadoCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:text="@string/cargando_categorias"
            style="@style/Dkafe.Body"
            android:layout_marginTop="6dp" />
        <Button
            android:id="@+id/botonGuardarProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:enabled="false"
            android:text="@string/guardar_producto"
            android:textAllCaps="false"
            style="@style/Dkafe.Button" />
    </LinearLayout>
</ScrollView>