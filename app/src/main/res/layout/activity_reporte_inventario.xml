<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".view.ReporteInventarioActivity"
    android:background="@color/dkafe_cream">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/reporte_inventario"
        style="@style/Dkafe.Title" />
    <LinearLayout
        android:id="@+id/resumenReporte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/textoTotalProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            style="@style/Dkafe.Body" />
        <TextView
            android:id="@+id/textoValorTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="18sp"
            style="@style/Dkafe.Body"
            android:textColor="@color/dkafe_wine"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/productos_stock_bajo"
            android:textSize="20sp"
            android:textStyle="bold"
            style="@style/Dkafe.Body" />
    </LinearLayout>
    <TextView
        android:id="@+id/textoEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/cargando_reporte"
        style="@style/Dkafe.Body" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaStockBajo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="16dp" />
</LinearLayout>